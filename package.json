{
	"name": "server",
	"version": "0.0.1",
	"description": "NestJS server application",
	"author": "Omnath Shinde",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"prepare": "husky"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1049.0",
		"@aws-sdk/client-s3": "^3.1049.0",
		"@aws-sdk/client-sqs": "^3.1050.0",
		"@aws-sdk/lib-dynamodb": "^3.1049.0",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/mapped-types": "*",
		"@nestjs/platform-express": "^11.1.21",
		"@nestjs/platform-socket.io": "^11.1.21",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/websockets": "^11.1.21",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dynamoose": "^4.2.0",
		"multer": "^2.1.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/express": "^5.0.6",
		"@types/jest": "^29.5.14",
		"@types/mocha": "^10.0.10",
		"@types/multer": "^2.1.0",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"globals": "^17.0.0",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^17.0.5",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.4.9",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	},
	"lint-staged": {
		"*.{js,ts,mjs,cjs,mts,cts}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	}
}
